---
import Layout from "src/component/Layout.astro";
import Table from "../../component/table/Table.svelte";

const { episode } = Astro.params;

const episodeNumber = Number(episode) || 1;
---

<Layout title="Wisdom Tracker">
    <main>
        <h1>EWOW Episode {episodeNumber} Statistics</h1>
        <Table episode={episodeNumber} client:load />
    </main>
</Layout>
