---
import NormalizedGraph from "../../component/profile/NormalizedGraph.svelte";
import LifeGraph from "../../component/profile/LifeGraph.svelte";
import { supabase } from "$lib/supabase"

const {uuid} = Astro.params;

async function getContestantData(uuid : string | undefined) {
    const { data, error } = await supabase
        .from("player")
        .select(`
        username,
        subtitle`)
        .eq("uuid", uuid).single();
    if (error) {
        console.error("Supabase error:", error);
        return;
    }
    return data
}


const contestantData = await getContestantData(uuid);

---


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
</head>
<body>
    <h1>{contestantData ? contestantData.username: "No user found"}</h1>
    <p>{contestantData?.subtitle}</p>
    <p>{uuid}</p>
    <NormalizedGraph {uuid} client:load />
    <LifeGraph {uuid} client:load />
</body>
</html>


<style></style>
