---
import Image from "astro/components/Image.astro";
import Layout from "src/component/Layout.astro";
import NormalizedGraph from "src/component/profile/NormalizedGraph.svelte";
import LifeGraph from "src/component/profile/LifeGraph.svelte";
import { supabase } from "$lib/supabase"

const {uuid} = Astro.params;

async function getContestantData(uuid : string | undefined) {
    const { data, error } = await supabase
        .from("player")
        .select(`
        uuid,
        username,
        subtitle,
        booksona (
            image_trim_uuid
        ),
        overall_rank (
            rank
        )
        `)
        .eq("uuid", uuid).single();
    if (error) {
        console.error("Supabase error:", error);
        return;
    }
    return data
}

const pr = new Intl.PluralRules("en-US", { type: "ordinal" });
const suffixes = new Map([
  ["one", "st"],
  ["two", "nd"],
  ["few", "rd"],
  ["other", "th"],
]);
const formatOrdinals = (n) => {
  const rule = pr.select(n);
  const suffix = suffixes.get(rule);
  return `${n}${suffix}`;
};


const contestantData = await getContestantData(uuid);

---


<Layout title="Profile">
    <div class="profile-data">
        <h1>{contestantData ? contestantData.username: "No user found"}</h1>
        <p>{contestantData?.subtitle}</p>
        <p>{uuid}</p>
        <Image 
        src=`https://cdn.booksona.lol/${contestantData?.booksona.image_trim_uuid}.png` 
        alt=`Booksona image of ${contestantData?.username}`}
        width={200}
        height={200}
        />
        <h1>Current Rank: {formatOrdinals(contestantData?.overall_rank[0].rank)}</h1>
    </div>
    <NormalizedGraph {uuid} client:load />
    <LifeGraph {uuid} client:load />
</Layout>
